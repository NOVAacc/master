        @file_put_contents($base.'/deployments/errors.log', date(DATE_ATOM).' '.get_class($e).' '.$e->getMessage()."\n", FILE_APPEND | LOCK_EX);
        @chmod($base.'/deployments/errors.log', 0600);
    }
    http_response_code(500);
    $safe = $e instanceof RuntimeException && preg_match('/^[a-z_]+$/', $e->getMessage()) ? $e->getMessage() : $phase.'_failed';
    echo json_encode(['error' => $safe]);
} finally {
    if (is_resource($lock)) { flock($lock, LOCK_UN); fclose($lock); }
}
